# 补充到 FastGPT 服务的实际环境变量；此文件不会自动加载。
# root 登录 /yunshu 后可读取当前团队 ID，填入以下配置并重启服务。
YUNSHU_ADMIN_TEAM_ID=
YUNSHU_ADMIN_ORIGINS=https://yunshu.example.com
YUNSHU_TEAM_COLLABORATION_ENABLED=false
# 开启后重启 FastGPT，root 在 /yunshu 同步现有共享应用权限。
# 指定内部团队全体活跃成员可维护图谱和编辑共享应用；系统 root 权限仍独立。

# GraphRAG 配置 GRAPHRAG_FASTGPT_ADMIN_TEAM_ID 为同一团队 ID，
# GRAPHRAG_FASTGPT_INTERNAL_URL 为固定的 FastGPT 内部服务地址。
# 两个界面经同源网关访问，GraphRAG 使用原生 fastgpt_token Cookie。
